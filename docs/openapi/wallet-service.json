{
    "openapi": "3.1.0",
    "info": {
        "title": "Mini Crypto Wallet - Wallet Service",
        "description": "\nOwns users, wallets, the ledger and balances. It is the only service that knows\nwhat anyone is owed.\n\nIt never talks to a blockchain. Deposits arrive as `deposit.confirmed` events;\ntransfers are published as `transfer.requested` and settled when\n`blockchain.transaction.confirmed` comes back.\n\n**Authentication** -- every endpoint requires `X-API-Key` (or\n`Authorization: Bearer <key>`). This stands in for real OAuth2/JWT; see the\nREADME.\n\n**Money format** -- all amounts are decimal strings (`\"250.000000\"`), never JSON\nnumbers.\n",
        "version": "1.0.0"
    },
    "paths": {
        "/health/live": {
            "get": {
                "tags": [
                    "ops"
                ],
                "summary": "Liveness probe",
                "operationId": "live_health_live_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "type": "object",
                                    "title": "Response Live Health Live Get"
                                }
                            }
                        }
                    }
                }
            }
        },
