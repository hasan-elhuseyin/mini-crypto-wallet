# ---------------------------------------------------------------------------
# Copy to .env before `docker compose up`. Every value here is a DEVELOPMENT
# default; none of them may be reused in a real environment.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- infrastructure --------------------------------------------------------
POSTGRES_USER=mcw
POSTGRES_PASSWORD=mcw
POSTGRES_DB=mcw

WALLET_DATABASE_URL=postgresql+psycopg://mcw:mcw@postgres:5432/wallet
BLOCKCHAIN_DATABASE_URL=postgresql+psycopg://mcw:mcw@postgres:5432/blockchain
REDIS_URL=redis://redis:6379/0

BLOCKCHAIN_SERVICE_URL=http://blockchain-api:8000

# --- authentication --------------------------------------------------------
# Stand-in for OAuth2/JWT at the edge and mTLS between services.
AUTH_ENABLED=true
API_KEY=dev-api-key-change-me
INTERNAL_API_KEY=dev-internal-key-change-me

# --- custody ---------------------------------------------------------------
# Fernet key used to encrypt private keys at rest.
# DEVELOPMENT KEY ONLY -- it is deliberately a recognisable byte pattern so it
# can never be mistaken for a real secret. In production this value comes from
# a KMS/secret manager and is never an environment variable (see README ->
# Security Considerations).
# Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEYSTORE_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# --- chain -----------------------------------------------------------------
# mock  -> self-contained simulated chain (default; models reorgs and faults)
# web3  -> a real EVM node (anvil / Hardhat / BSC testnet)
CHAIN_BACKEND=mock
CHAIN_NETWORK=BSC
CONFIRMATIONS_REQUIRED=3
FINALITY_DEPTH=15
SCAN_BATCH_BLOCKS=200
REORG_SAFETY_BLOCKS=20
MOCK_BLOCK_TIME_SECONDS=1.0
MOCK_AUTO_MINE=true

# Only used when CHAIN_BACKEND=web3
WEB3_RPC_URL=http://anvil:8545
WEB3_CHAIN_ID=31337
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# --- workers ---------------------------------------------------------------
WORKER_POLL_SECONDS=1.0
BROADCAST_MAX_ATTEMPTS=5
PENDING_TIMEOUT_SECONDS=120
CONSUMER_MAX_DELIVERY=5
CONSUMER_CLAIM_IDLE_MS=15000

# --- observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- safety ----------------------------------------------------------------
# Chain simulation endpoints (/simulate/*). MUST be false outside development.
ENABLE_SIMULATION_API=true
